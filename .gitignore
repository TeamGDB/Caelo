# Внутренние заметки, не для публичного репо
product.md

# IDE
.idea/
.vscode/
*.iml

# macOS
.DS_Store

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.g.dart
# pubspec.lock is committed on purpose — Caelo is an application, not a package

# Native libraries built from caelo-core. Build output, not source: a
# checked-in binary is one nobody can tell you the provenance of.
*.dylib
*.so
*.dll
*.framework/
*.xcframework/
android/app/src/main/jniLibs/
ios/Frameworks/caelo.xcframework/

# CocoaPods. The lockfile is committed so a checkout resolves to the same
# pods; the installed copies are not.
ios/Pods/
macos/Pods/

# Xcode
xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# Go build output from core/
core/build/
core/vendor/

# Signing and secrets — never commit these
*.p12
*.mobileprovision
*.provisionprofile
.env
.env.*

# Tunnel configs and keys. Real ones carry live credentials; keep test configs
# outside the working tree entirely (~/.caelo-dev/) rather than relying on this.
*.conf
*.key
*.pem
secrets/
local/
