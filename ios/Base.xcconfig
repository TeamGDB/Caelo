// Signing identity for every target, in the repository rather than in one
// person's Xcode. A team selected through the UI lives in project.pbxproj as a
// literal, which turns every developer's first build into a diff.
//
// The packet tunnel extension will share these when it lands: its bundle
// identifier has to be a child of the app's, and its app group has to be named
// after the same base.

DEVELOPMENT_TEAM = BM4788UD8M

// What the app asks Apple for. Automatic signing only requests entitlements
// the target declares, so a capability enabled on the App ID stays invisible
// until this file asks for it.
CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements
BASE_BUNDLE_IDENTIFIER = team.gdb.caelo

// The core, linked straight into the binary.
//
// -force_load is not optional. The archive is static and nothing in Swift or
// Objective-C references these symbols — Dart looks them up at runtime — so
// without it the linker discards every one of them and the app builds cleanly
// into something that cannot find its own core.
//
// The slice is chosen by SDK because an xcframework is only a directory as far
// as a static library is concerned.
CAELO_LIB[sdk=iphoneos*] = $(SRCROOT)/Frameworks/caelo.xcframework/ios-arm64/libcaelo.a
CAELO_LIB[sdk=iphonesimulator*] = $(SRCROOT)/Frameworks/caelo.xcframework/ios-arm64-simulator/libcaelo.a

// -export_dynamic is the other half of -force_load, and just as necessary.
// force_load keeps the code; without this the symbols still never reach the
// dynamic table, and dlsym -- which is what Dart's DynamicLibrary.process()
// uses -- looks only there. The binary then contains its own core and cannot
// find it.
//
// resolv and the two frameworks are what the Go runtime needs on Apple
// platforms: DNS, and the system trust store for TLS.
OTHER_LDFLAGS = $(inherited) -force_load $(CAELO_LIB) -Wl,-export_dynamic -lresolv -framework CoreFoundation -framework Security
