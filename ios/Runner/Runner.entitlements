<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app manages the tunnel; the extension will run it. Both need this,
	     and Apple grants it by request rather than by checkbox. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<!-- How the app and the extension will reach each other. They are separate
	     processes on iOS and share nothing else, and the tunnel's own log is
	     written on the far side of that boundary. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.team.gdb.caelo</string>
	</array>
</dict>
</plist>
